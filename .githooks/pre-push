#!/bin/sh
# Refuses direct pushes to main and runs the gate before any other push.
# Enable once per checkout: git config core.hooksPath .githooks
# Only the owner may bypass it (git push --no-verify), for emergencies.
set -eu

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are not allowed; open a pull request." >&2
    exit 1
  fi
done

npm run -s check
