{
  "name": "pi-mistral-subscription",
  "version": "0.1.1",
  "description": "Pi package adding Mistral subscription sign-in through Mistral AI Studio to Pi's built-in mistral provider.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "mistral",
    "oauth"
  ],
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/mistral-subscription"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.0",
    "@earendil-works/pi-coding-agent": ">=0.99.0"
  },
  "scripts": {
    "test": "node --test --test-reporter=dot --import tsx \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci --colors=off .",
    "secrets": "secretlint \"**/*\"",
    "pack:check": "npm pack --dry-run --loglevel=error > /dev/null",
    "check": "npm run -s lint && npm run -s test && npm run -s typecheck && npm run -s secrets && npm run -s pack:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@types/node": "~22.20.5",
    "secretlint": "^13.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
